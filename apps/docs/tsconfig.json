{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": ["blume.config.ts", "themes", "scripts"],
  "exclude": ["dist", ".snippets", ".blume", ".blume-verify", "scripts/snippet-stubs"]
}
