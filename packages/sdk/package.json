{
  "name": "@opencoredev/sandbox-sdk",
  "version": "1.0.0-beta.1",
  "description": "One TypeScript API for cloud and local sandboxes: E2B, Daytona, Vercel, Upstash, Docker, and more. Run commands, edit files, start servers, and give AI agents a sandbox.",
  "keywords": [
    "sandbox",
    "code-execution",
    "ai-agents",
    "agent-tools",
    "e2b",
    "daytona",
    "vercel-sandbox",
    "upstash",
    "docker",
    "microvm",
    "ai-sdk",
    "mastra",
    "openai-agents",
    "typescript"
  ],
  "homepage": "https://sandbox-sdk.app",
  "bugs": {
    "url": "https://github.com/opencoredev/sandbox-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opencoredev/sandbox-sdk.git",
    "directory": "packages/sdk"
  },
  "license": "MIT",
  "author": "OpenCore",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./provider": {
      "types": "./dist/provider.d.ts",
      "default": "./dist/provider.js"
    },
    "./memory": {
      "types": "./dist/memory.d.ts",
      "default": "./dist/memory.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./tools": {
      "types": "./dist/tools.d.ts",
      "default": "./dist/tools.js"
    },
    "./ai": {
      "types": "./dist/ai.d.ts",
      "default": "./dist/ai.js"
    },
    "./mastra": {
      "types": "./dist/mastra.d.ts",
      "default": "./dist/mastra.js"
    },
    "./openai": {
      "types": "./dist/openai.d.ts",
      "default": "./dist/openai.js"
    },
    "./local": {
      "types": "./dist/providers/local/index.d.ts",
      "default": "./dist/providers/local/index.js"
    },
    "./e2b": {
      "types": "./dist/providers/e2b/index.d.ts",
      "default": "./dist/providers/e2b/index.js"
    },
    "./vercel": {
      "types": "./dist/providers/vercel/index.d.ts",
      "default": "./dist/providers/vercel/index.js"
    },
    "./daytona": {
      "types": "./dist/providers/daytona/index.d.ts",
      "default": "./dist/providers/daytona/index.js"
    },
    "./upstash": {
      "types": "./dist/providers/upstash/index.d.ts",
      "default": "./dist/providers/upstash/index.js"
    },
    "./railway": {
      "types": "./dist/providers/railway/index.d.ts",
      "default": "./dist/providers/railway/index.js"
    },
    "./boat": {
      "types": "./dist/providers/boat/index.d.ts",
      "default": "./dist/providers/boat/index.js"
    },
    "./sandboxer": {
      "types": "./dist/providers/sandboxer/index.d.ts",
      "default": "./dist/providers/sandboxer/index.js"
    },
    "./tenki": {
      "types": "./dist/providers/tenki/index.d.ts",
      "default": "./dist/providers/tenki/index.js"
    },
    "./agentos": {
      "types": "./dist/providers/agentos/index.d.ts",
      "default": "./dist/providers/agentos/index.js"
    },
    "./boxd": {
      "types": "./dist/providers/boxd/index.d.ts",
      "default": "./dist/providers/boxd/index.js"
    },
    "./freestyle": {
      "types": "./dist/providers/freestyle/index.d.ts",
      "default": "./dist/providers/freestyle/index.js"
    },
    "./superserve": {
      "types": "./dist/providers/superserve/index.d.ts",
      "default": "./dist/providers/superserve/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bun scripts/build.ts && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src tests scripts",
    "test": "timeout 120s vitest run --maxWorkers=4 && bun scripts/size.ts",
    "check:size": "bun scripts/size.ts",
    "smoke:consumer": "timeout 900s bun scripts/consumer-smoke.ts",
    "smoke:consumer:nopeers": "timeout 900s bun scripts/consumer-smoke-nopeers.ts",
    "smoke:bundle": "timeout 600s bun scripts/bundle-smoke.ts"
  },
  "devDependencies": {
    "@boatdev/sdk": "1.9.9",
    "@boxd-sh/sdk": "0.2.17",
    "@daytonaio/sdk": "^0.225.0",
    "@mastra/core": "^1.78.0",
    "@openai/agents": "^0.20.0",
    "@rivet-dev/agentos-core": "0.4.1",
    "@tenkicloud/sandbox": "^1.4.1",
    "@upstash/box": "^0.7.9",
    "@vercel/sandbox": "3.8.0",
    "ai": "^7.0.143",
    "e2b": "2.56.0",
    "esbuild": "0.28.1",
    "freestyle": "0.2.20",
    "railway": "3.16.0",
    "vitest": "^3.2.4",
    "zod": "^4.6.7",
    "@superserve/sdk": "0.11.4"
  },
  "peerDependencies": {
    "@daytonaio/sdk": ">=0.225.0 <1.0.0",
    "@mastra/core": "^1.78.0",
    "@openai/agents": "^0.20.0",
    "@upstash/box": "^0.7.9",
    "@vercel/sandbox": "^3.8.0",
    "ai": "^7.0.143",
    "e2b": "^2.56.0",
    "vitest": ">=3",
    "zod": "^4.6.7",
    "railway": "^3.16.0",
    "@boatdev/sdk": "^1.9.9",
    "@tenkicloud/sandbox": "^1.4.1",
    "@rivet-dev/agentos-core": "0.4.1",
    "@boxd-sh/sdk": "^0.2.17",
    "freestyle": "^0.2.20"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "@mastra/core": {
