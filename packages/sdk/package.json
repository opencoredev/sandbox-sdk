      "optional": true
    },
    "@daytonaio/sdk": {
      "optional": true
    },
    "@upstash/box": {
      "optional": true
    },
    "railway": {
      "optional": true
    },
    "@boatdev/sdk": {
      "optional": true
    },
    "@tenkicloud/sandbox": {
      "optional": true
    },
