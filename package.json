{
  "name": "sandbox-sdk",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "bench",
    "examples/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "check-types": "bun run typecheck",
    "test": "turbo run test",
    "test:ci": "turbo run test --concurrency=1",
    "smoke:package": "bun run --cwd packages/sdk smoke:bundle && bun run --cwd packages/sdk smoke:consumer",
    "test:live": "turbo run test:live",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "bun run format && bun run lint && bun run typecheck && bun run test",
    "bench": "bun run --cwd bench bench",
    "changeset": "changeset",
    "version-packages": "changeset version && bun packages/sdk/scripts/sync-version.ts && oxfmt --write packages/sdk/CHANGELOG.md && bun install --lockfile-only",
    "release": "bun scripts/release.ts"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@changesets/changelog-git": "1.0.0",
    "@changesets/cli": "3.0.3",
    "@oxlint/plugins": "1.90.0",
    "@shadcn/lint": "0.2.3",
    "@types/node": "^22.20.1",
    "better-icons": "^1.0.4",
    "oxfmt": "^0.59.0",
    "oxlint": "1.90.0",
    "turbo": "^2.10.5",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@hono/node-server@<2.1.3": "2.1.3",
    "@modelcontextprotocol/sdk@<1.32.0": "1.32.1",
    "baseline-browser-mapping@<2.11.0": "2.11.0",
    "brace-expansion@<1.1.21": "1.1.21",
    "compression@<1.8.2": "1.8.2",
    "fast-uri@>=3.0.0 <3.1.9": "3.1.9",
    "follow-redirects@<1.16.2": "1.16.2",
    "glob@>=9.0.0 <14.0.2": "14.0.2",
    "ip-address@<10.7.4": "10.7.4",
    "minimatch@>=10.0.0 <11.0.1": "11.0.1",
    "nanoid@<3.3.18": "3.3.18",
    "path-to-regexp@>=4.0.0 <6.3.0": "6.3.0",
    "postcss-selector-parser@<6.1.5": "6.1.5",
    "postcss@<8.5.23": "8.5.23",
    "proxy-addr@<2.0.8": "2.0.8",
    "qs@<6.16.1": "6.16.1",
    "source-map-js@<1.2.2": "1.2.2",
    "tinypool@<2.1.2": "2.1.2",
    "undici@>=7.0.0 <7.30.1": "7.30.1",
    "uuid@<11.0.0": "11.1.1"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.4.4"
}
