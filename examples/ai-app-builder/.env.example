# Which sandbox provider to use: local (Docker, default), e2b, vercel, or daytona.
SANDBOX_PROVIDER=local

# Model as <provider>:<model id>. anthropic, openai, and gateway are supported.
# Set AI_MODEL=scripted to replay a fixed build script with no model and no API key.
AI_MODEL=anthropic:claude-opus-5-5
ANTHROPIC_API_KEY=

# Only for the provider you pick:
# OPENAI_API_KEY=
# AI_GATEWAY_API_KEY=
# E2B_API_KEY=
# VERCEL_TOKEN=  VERCEL_TEAM_ID=  VERCEL_PROJECT_ID=
# DAYTONA_API_KEY=
